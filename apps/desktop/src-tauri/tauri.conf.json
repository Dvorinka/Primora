{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Primora",
  "version": "0.6.0",
  "identifier": "dev.tdvorak.primora",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Primora",
        "width": 1280,
        "height": 800,
        "minWidth": 420,
        "minHeight": 640,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost https: http:; img-src 'self' data:; style-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Primora desktop client",
    "longDescription": "Thin desktop shell for a self-hosted Primora deployment. Renders the console served by your own server.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
