{
  "name": "@primora/mcp",
  "version": "0.2.0",
  "publishConfig": {
    "access": "public"
  },
  "description": "Primora MCP server — operate projects, storage, keys and audit from any MCP client",
  "type": "module",
  "bin": {
    "primora-mcp": "dist/server.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "esbuild src/server.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/server.js --banner:js=\"#!/usr/bin/env node\"",
    "dev": "npm run build && node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@primora/api-client": "0.2.0",
    "@types/node": "^24.0.0",
    "esbuild": "^0.27.4",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=20"
  }
}
